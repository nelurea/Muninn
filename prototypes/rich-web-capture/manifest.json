{
  "manifest_version": 3,
  "name": "Muninn Rich Web Capture Prototype",
  "version": "0.3.0",
  "description": "Prototype rich web capture for Muninn.",

  "permissions": [
    "downloads",
    "declarativeNetRequestWithHostAccess"
  ],

  "host_permissions": [
    "https://i.pximg.net/*",
    "https://pbs.twimg.com/*"
  ],

  "action": {
    "default_title": "Capture with Muninn"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.pixiv.net/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.pixiv.net/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "x-page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "x-content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}